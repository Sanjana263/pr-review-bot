# Port the server listens on (optional, defaults to 3000)
PORT=3000

# Personal access token (or GitHub App token) with repo scope,
# used to fetch PR diffs and post review comments
GITHUB_TOKEN=

# Secret configured on the GitHub webhook, used to verify
# that incoming requests genuinely came from GitHub
GITHUB_WEBHOOK_SECRET=

# API key for Google's Gemini API (Google AI Studio)
GEMINI_API_KEY=
